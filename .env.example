PORT=3000

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=your_database_name

# Outlook365 uses Nodemailer's built-in service settings; no SMTP host is needed.
SMTP_SERVICE=Outlook365
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-outlook-email@example.com
SMTP_PASS=your-outlook-password-or-app-password

MAIL_FROM="your-outlook-email@example.com"

# DigitalOcean Spaces
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_KEY=your_spaces_key
DO_SPACES_SECRET=your_spaces_secret
DO_SPACES_BUCKET=your_bucket_name
DO_SPACES_REGION=nyc3
DO_SPACES_URL_EXPIRES=3600
DO_SPACES_FOLDER=email-files
UPLOAD_MAX_SIZE_MB=500
